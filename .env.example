# Watchtower environment variables — NAMES ONLY. Never put real values in this file.
# Real values live in: Render env (dashboard), GitHub Actions secrets/variables (worker), local .env (dev).
# Worker: secrets = WT_DATABASE_URL, WT_DATABASE_CA_CERT, RENDER_API_KEY, SENTRY_API_TOKEN;
#         variables (not secret) = APP_HEALTH_URL, POLL_*, RENDER_OWNER_ID, RENDER_SERVICE_ID, SENTRY_API_URL, SENTRY_ORG, SENTRY_PROJECT, KILL_SWITCH.
# Dashboard (Render): WT_DATABASE_URL, WT_DATABASE_CA_CERT, ADMIN_USER, ADMIN_PASSWORD_HASH, SESSION_SECRET, POLL_TIMEZONE, KILL_SWITCH.

# --- Watchtower's own database (Aiven MySQL, database `watchtower`, user `watchtower`) ---
# Must NOT be the app's credentials. User has grants on watchtower.* only.
WT_DATABASE_URL=
WT_DATABASE_CA_CERT=

# --- Dashboard auth (single admin) ---
ADMIN_USER=
# scrypt hash, generated with `npm run hash-password` (phase 2). Never store the plain password.
ADMIN_PASSWORD_HASH=
# >= 32 characters of randomness (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Session ids are stored only as HMAC(token, SESSION_SECRET).
SESSION_SECRET=

# --- Target app ---
APP_REPO=RiazShaik79/Place-and-Plate
# e.g. https://place-and-plate.onrender.com/api/health (public, no credentials)
APP_HEALTH_URL=
# IANA timezone + active window for the health-poll cadence (see ADR 0002)
POLL_TIMEZONE=Asia/Kolkata
POLL_ACTIVE_HOURS=07-23

# --- Render (worker only; GitHub Actions secret in this repo, never on the dashboard) ---
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_SERVICE_ID=

# --- GitHub ---
# Read-only token for the app's (public) source during diagnosis. In the worker this is the job's own
# github.token; locally it's optional (unauthenticated reads work, with a lower rate limit).
GITHUB_CONTENTS_TOKEN=
# Fine-grained PAT: app repo only; Actions RW, Contents R, Metadata R. Used by the dashboard to dispatch fixes.
GITHUB_DISPATCH_TOKEN=
# Fine-grained PAT: Watchtower repo only; Actions RW. Lets the dashboard trigger "Run worker now".
GITHUB_WORKER_TOKEN=
WATCHTOWER_REPO=

# --- Anthropic (from phase 3; worker only: GitHub Actions secret, never on the dashboard) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_DEEP_MODEL=claude-opus-5-5

# --- Guardrails ---
# true disables ALL agent calls and workflow triggers (also a dashboard toggle; either one wins)
KILL_SWITCH=false
DIAG_MAX_PER_HOUR=5
DIAG_MAX_PER_DAY=20
MONTHLY_API_BUDGET_USD=20

# --- Sentry (read-only poller; the API was verified to work on Developer, 2026-10-29) ---
# Personal token with Project: Read + Issue & Event: Read only. The org is in the EU region.
SENTRY_API_URL=https://de.sentry.io
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
